---
import { Font } from 'astro:assets';
import { site } from '../config/site';
import Navbar from '../components/Navbar.astro';
import FriendLinks from '../components/FriendLinks.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { BreadcrumbItemData } from '../types/breadcrumb';
import '../styles/globals.css';

type Props = {
  title?: string;
  description?: string;
  keywords?: string[] | string;
  image?: string;
  breadcrumbs?: BreadcrumbItemData[];
  hideBreadcrumbs?: boolean;
};

const { title, description, keywords, image, breadcrumbs, hideBreadcrumbs } = Astro.props;
const isHome = Astro.url.pathname === '/';
const pageTitle = isHome
  ? `${site.name} - ${site.tabTagline ?? site.tagline}`
  : title
    ? `${title} - ${site.name}`
    : site.name;
const pageDescription = description ?? site.tagline;
const showFriendLinks = isHome;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const mergedKeywords = Array.from(
  new Set(
    [
      ...(Array.isArray(site.keywords) ? site.keywords : []),
      ...(typeof keywords === 'string' ? keywords.split(',') : keywords ?? []),
    ]
      .map((s) => String(s).trim())
      .filter(Boolean)
  )
);
const keywordsContent = mergedKeywords.join(', ');
const ogImage = image || undefined;

function defaultBreadcrumbs(pathname: string): BreadcrumbItemData[] {
  const out: BreadcrumbItemData[] = [{ label: '首页', href: '/' }];
  const trimmed = pathname.replace(/\/+$/, '');
  if (!trimmed || trimmed === '') return out;

  const segments = trimmed.split('/').filter(Boolean);
  const labelMap: Record<string, string> = {
    categories: '分类',
    tags: '标签',
    search: '搜索',
    docs: '文档',
    category: '分类',
    tag: '标签',
    page: '分页',
  };

  let href = '';
  for (let i = 0; i < segments.length; i++) {
    const seg = segments[i];
    href += `/${seg}`;

    const prev = segments[i - 1];
    if (prev === 'page') {
      const n = Number(seg);
      out.push({ label: Number.isFinite(n) ? `第 ${n} 页` : decodeURIComponent(seg), href });
      continue;
    }

    const label = labelMap[seg] ?? decodeURIComponent(seg).replace(/-/g, ' ');
    out.push({ label, href });
  }

  if (out.length) out[out.length - 1] = { label: out[out.length - 1].label };
  return out;
}

const breadcrumbItems = breadcrumbs ?? defaultBreadcrumbs(Astro.url.pathname);
const showBreadcrumbs = !isHome && !hideBreadcrumbs;
const commentsEnabled = site.comments.enabled;
const artalkServerUrl = site.api.artalkServerUrl.trim();
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script defer src="https://ays.sin0.cc/script.js" data-website-id="7bf402eb-d3a3-468c-84b7-3c6a9b2a54dc"></script>
    <link rel="canonical" href={canonicalUrl} />
    {commentsEnabled && artalkServerUrl ? (
      <>
        <link rel="dns-prefetch" href={artalkServerUrl} />
        <link rel="preconnect" href={artalkServerUrl} crossorigin />
      </>
    ) : null}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywordsContent} />
    <meta name="robots" content="index,follow" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
    <Font cssVariable="--font-noto-sans-sc" />
    <Font cssVariable="--font-noto-sans-jp" />
    <Font cssVariable="--font-noto-sans-mono" />
    <Font cssVariable="--font-outfit" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia?.('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          const root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.style.colorScheme = theme;
        } catch {}
      })();
    </script>
    {commentsEnabled ? (
      <script>
        const preloadArtalk = () => {
          const globalState = window as Window & {
            __artalkPreloadPromise?: Promise<unknown>;
          };
          globalState.__artalkPreloadPromise ??= import('artalk');
        };

        const idleWindow = window as Window & {
          requestIdleCallback?: (callback: () => void, options?: { timeout?: number }) => number;
        };

        if (typeof idleWindow.requestIdleCallback === 'function') {
          idleWindow.requestIdleCallback(preloadArtalk, { timeout: 2000 });
        } else {
          window.setTimeout(preloadArtalk, 600);
        }
      </script>
    ) : null}
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <Navbar />
    <main class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 pb-4 pt-[4.5rem] md:pb-5 md:pt-20">
      {showBreadcrumbs ? (
        <div class="mb-4">
          <Breadcrumbs items={breadcrumbItems} />
        </div>
      ) : null}
      <slot />
    </main>
    <BackToTop />
    {showFriendLinks ? <FriendLinks /> : null}
    <Footer />
    <script>
      import { installExternalLinkNormalizer } from '../lib/redirect';
      import { scheduleSearchIndexPreload } from '../lib/search-client';
      import { initLazyImages } from '../scripts/lazyload';

      installExternalLinkNormalizer();
      scheduleSearchIndexPreload();
      initLazyImages();
      document.addEventListener('astro:page-load', scheduleSearchIndexPreload);
    </script>
  </body>
</html>

