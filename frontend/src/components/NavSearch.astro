---
import { Search, X } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Dialog from '@/components/ui/Dialog.astro';

type Props = {
  mode: 'desktop' | 'mobile' | 'dialog';
};

const { mode } = Astro.props;
const dialogId = 'nav-search-dialog';
const triggerClass = mode === 'desktop' ? 'nav-search-trigger nav-search-trigger--desktop' : 'nav-search-trigger';
---

{
  mode === 'dialog' ? (
    <Dialog id={dialogId} title="搜索文章" class="nav-search-dialog">
      <form class="nav-search-dialog__form" action="/search" method="get" role="search" data-nav-search-form>
        <div class="nav-search-dialog__control">
          <div class="nav-search-dialog__input-row">
            <Search class="nav-search-dialog__input-icon" />
            <input
              class="nav-search-dialog__input"
              type="search"
              name="q"
              autocomplete="off"
              placeholder="搜索标题、标签、正文"
              aria-label="搜索文章"
              data-nav-search-input
            />
            <Button
              type="button"
              variant="ghost"
              size="icon"
              class="nav-search-dialog__clear"
              ariaLabel="清空搜索"
              hidden
              data-nav-search-clear
            >
              <X class="nav-search-dialog__clear-icon" />
            </Button>
          </div>
        </div>
        <Button
          type="submit"
          variant="solid"
          size="md"
          class="nav-search-dialog__submit"
          ariaLabel="提交搜索"
        >
          搜索
        </Button>
      </form>

      <script>
        import { initNavSearch } from '@/scripts/nav-search';

        initNavSearch();
        document.addEventListener('astro:page-load', initNavSearch);
      </script>
    </Dialog>
  ) : (
    <Button
      type="button"
      variant="ghost"
      size="icon"
      class={triggerClass}
      ariaLabel="搜索文章"
      title="搜索文章"
      data-nav-search-open
    >
      <Search class="nav-search-trigger__icon" />
    </Button>
  )
}
