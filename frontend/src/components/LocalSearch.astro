---
import { Clock, Search, Trash2, X } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
---

<div class="space-y-4" data-local-search>
  <form class="space-y-3" data-local-search-form>
    <label class="block text-sm font-medium" for="local-search-q">关键词</label>
    <div class="flex items-center gap-2">
      <div class="relative flex-1">
        <Search class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-[rgb(var(--color-text-muted))]" />
        <input
          id="local-search-q"
          class="h-11 w-full rounded-lg border border-[rgb(var(--color-border))] bg-white pl-10 pr-10 text-sm text-[rgb(var(--color-text))] outline-none transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-[rgb(var(--color-text-muted))] focus:border-[rgb(var(--color-primary))] focus:shadow-[0_0_0_3px_rgb(var(--color-primary)_/_0.16)] dark:border-[rgb(var(--color-border)_/_0.92)] dark:bg-[rgb(var(--color-surface-muted))] dark:text-[rgb(var(--color-text))] dark:placeholder:text-[rgb(var(--color-text-muted))] dark:focus:border-[rgb(var(--color-primary))] dark:focus:shadow-[0_0_0_3px_rgb(var(--color-primary)_/_0.18)]"
          type="search"
          autoComplete="off"
          placeholder="输入关键词（空格分隔）"
          data-local-search-input
        />
        <button
          type="button"
          class="absolute right-3 top-1/2 hidden flex size-5 -translate-y-1/2 items-center justify-center text-[rgb(var(--color-text-muted))]"
          aria-label="清空搜索"
          data-local-search-clear
        >
          <X class="size-4" />
        </button>
      </div>
      <Button type="submit" variant="outline" class="h-11 px-4">
        <Search class="size-4" />
        搜索
      </Button>
    </div>
  </form>

  <section class="hidden space-y-2" data-local-search-history-section>
    <div class="flex items-center justify-between gap-3">
      <div class="inline-flex items-center gap-2 text-sm text-[rgb(var(--color-text-muted))]">
        <Clock class="size-4" />
        <span>历史搜索</span>
      </div>
      <Button type="button" variant="ghost" size="sm" class="h-auto px-1" data-local-search-history-clear>
        <Trash2 class="size-4" />
        清空
      </Button>
    </div>
    <div class="flex flex-wrap gap-2" data-local-search-history></div>
  </section>

  <div data-local-search-results></div>
</div>

<script>
  import { initLocalSearch } from '@/scripts/local-search';

  initLocalSearch();
  document.addEventListener('astro:page-load', initLocalSearch);
</script>
