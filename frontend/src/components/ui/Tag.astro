---
import { cn } from '@/lib/utils';

type Props = {
  href?: string;
  class?: string;
};

const { href, class: className } = Astro.props;
const classes = cn(
  'inline-flex shrink-0 items-center rounded-lg bg-[rgb(var(--color-primary))] px-2.5 py-1 text-xs font-semibold text-[rgb(var(--color-primary-foreground))]',
  className
);
---

{
  href ? (
    <a href={href} class={classes} data-dark-dim>
      <slot />
    </a>
  ) : (
    <span class={classes} data-dark-dim>
      <slot />
    </span>
  )
}
