---
import { cn } from '@/lib/utils';

type Props = {
  class?: string;
  padded?: boolean;
  hoverable?: boolean;
};

const { class: className, padded = false, hoverable = false } = Astro.props;

const classes = cn(
  'overflow-hidden rounded-xl border border-[rgb(var(--color-border)_/_0.9)] bg-[rgb(var(--color-surface))]',
  hoverable && '',
  padded && 'p-4 sm:p-5',
  className
);
---

<div class={classes}>
  <slot />
</div>
