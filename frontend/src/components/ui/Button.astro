---
import { cn } from '@/lib/utils';

type Variant = 'solid' | 'outline' | 'ghost' | 'soft';
type Size = 'sm' | 'md' | 'lg' | 'icon';

type Props = {
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant;
  size?: Size;
  class?: string;
  disabled?: boolean;
  ariaLabel?: string;
};

const {
  href,
  target,
  rel,
  type = 'button',
  variant = 'outline',
  size = 'md',
  class: className,
  disabled = false,
  ariaLabel,
  ...attrs
} = Astro.props;

const baseClass =
  'inline-flex items-center justify-center gap-2 rounded-lg font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--color-primary)_/_0.22)] disabled:pointer-events-none disabled:opacity-50';

const variantClass = {
  solid:
    'bg-[rgb(var(--color-primary)_/_0.84)] text-[rgb(var(--color-primary-foreground))]',
  outline:
    'border border-[rgb(var(--color-border)_/_0.92)] bg-[rgb(var(--color-surface))] text-[rgb(var(--color-text)_/_0.86)]',
  ghost:
    'text-[rgb(var(--color-text-muted))]',
  soft:
    'bg-[rgb(var(--color-primary-muted)_/_0.68)] text-[rgb(var(--color-primary))] dark:bg-[rgb(var(--color-primary-muted)_/_0.72)]',
}[variant];

const sizeClass = {
  sm: 'h-9 px-3 text-sm',
  md: 'h-10 px-4 text-sm',
  lg: 'h-11 px-5 text-base',
  icon: 'size-10',
}[size];

const classes = cn(baseClass, variantClass, sizeClass, className);
---

{
  href && !disabled ? (
    <a href={href} target={target} rel={rel} class={classes} aria-label={ariaLabel} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} aria-label={ariaLabel} {...attrs}>
      <slot />
    </button>
  )
}
