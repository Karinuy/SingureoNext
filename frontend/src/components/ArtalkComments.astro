---
import { MessageCircle } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import 'artalk/Artalk.css';

type Props = {
  pageKey: string;
  pageTitle: string;
};

const { pageKey, pageTitle } = Astro.props;
const artalkServer = site.artalk.server.trim();
---

{site.artalk.enabled ? (
  <section class="mt-10" aria-labelledby="artalk-comments-title">
    <h2 id="artalk-comments-title" class="text-base font-semibold tracking-tight">评论</h2>
    <div
      data-artalk-comments
      data-page-key={pageKey}
      data-page-title={pageTitle}
      data-server={artalkServer}
      data-site={site.name}
      class="artalk-comments mt-4 min-h-32"
    >
      {artalkServer ? (
        <p class="text-sm text-[rgb(var(--color-text-muted))]">评论加载中...</p>
      ) : (
        <p class="text-sm text-[rgb(var(--color-text-muted))]">评论服务暂未配置</p>
      )}
    </div>
    <div class="fixed bottom-24 right-5 z-50 md:right-6 lg:bottom-36 lg:right-8">
      <Button
        variant="outline"
        size="icon"
        class="size-14 rounded-full shadow-xl"
        ariaLabel="前往评论"
        title="前往评论"
        data-scroll-to-comments
      >
        <MessageCircle class="size-5" />
      </Button>
    </div>
  </section>
) : null}

<script>
  type ArtalkInstance = {
    destroy: () => void;
    ctx?: {
      get: (name: 'layerManager') => ArtalkLayerManager;
    };
    setDarkMode: (darkMode: boolean) => void;
  };

  type ArtalkLayer = {
    show: () => void;
    hide: () => void;
    destroy: () => void;
  };

  type ArtalkLayerManager = {
    create: (name: string, el?: HTMLElement) => ArtalkLayer;
    __scrollStablePatched?: boolean;
  };

  type PageScrollSnapshot = {
    left: number;
    top: number;
    bodyOverflow: string;
    bodyPaddingRight: string;
  };

  type ArtalkModule = {
    default: {
      init: (config: Record<string, unknown>) => ArtalkInstance;
    };
  };

  type ArtalkContainer = HTMLElement & {
    __artalk?: ArtalkInstance;
    __artalkThemeObserver?: MutationObserver;
  };

  type ArtalkGlobalState = Window & {
    __artalkPreloadPromise?: Promise<unknown>;
  };

  const getArtalk = async () => {
    const globalState = window as ArtalkGlobalState;
    const mod = await (globalState.__artalkPreloadPromise ?? import('artalk'));
    return (mod as unknown as ArtalkModule).default;
  };

  const isDarkMode = () => document.documentElement.classList.contains('dark');

  const getPageScrollSnapshot = (): PageScrollSnapshot => ({
    left: window.scrollX,
    top: window.scrollY,
    bodyOverflow: document.body.style.overflow,
    bodyPaddingRight: document.body.style.paddingRight,
  });

  const restorePageAfterArtalkLayerChange = (snapshot: PageScrollSnapshot) => {
    const restore = () => {
      document.body.style.overflow = snapshot.bodyOverflow;
      document.body.style.paddingRight = snapshot.bodyPaddingRight;
      if (window.scrollX !== snapshot.left || window.scrollY !== snapshot.top) {
        window.scrollTo(snapshot.left, snapshot.top);
      }
    };

    restore();
    window.requestAnimationFrame(restore);
    window.setTimeout(restore, 120);
  };

  const keepPageStableDuringLayerChange = (changeLayer: () => void) => {
    const snapshot = getPageScrollSnapshot();
    changeLayer();
    restorePageAfterArtalkLayerChange(snapshot);
  };

  const patchLayerScrollJump = (instance: ArtalkInstance) => {
    const layerManager = instance.ctx?.get('layerManager');
    if (!layerManager || layerManager.__scrollStablePatched) return;

    const createLayer = layerManager.create.bind(layerManager);
    layerManager.create = (name, el) => {
      const layer = createLayer(name, el);
      const show = layer.show.bind(layer);
      const hide = layer.hide.bind(layer);
      const destroy = layer.destroy.bind(layer);

      layer.show = () => keepPageStableDuringLayerChange(show);
      layer.hide = () => keepPageStableDuringLayerChange(hide);
      layer.destroy = () => keepPageStableDuringLayerChange(destroy);

      return layer;
    };
    layerManager.__scrollStablePatched = true;
  };

  const initArtalk = async (container: ArtalkContainer) => {
    if (container.dataset.artalkBound === 'true') return;

    const server = container.dataset.server?.trim();
    if (!server) return;

    container.dataset.artalkBound = 'true';
    const Artalk = await getArtalk();
    const instance = Artalk.init({
      el: container,
      pageKey: container.dataset.pageKey,
      pageTitle: container.dataset.pageTitle,
      server,
      site: container.dataset.site,
      locale: 'zh-CN',
      darkMode: isDarkMode(),
      pvEl: '[data-artalk-pv-current]',
      countEl: '[data-artalk-comment-current]',
    });
    patchLayerScrollJump(instance);

    const observer = new MutationObserver(() => {
      instance.setDarkMode(isDarkMode());
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    container.__artalk = instance;
    container.__artalkThemeObserver = observer;
  };

  const initAllArtalk = () => {
    document.querySelectorAll<ArtalkContainer>('[data-artalk-comments]').forEach((container) => {
      initArtalk(container).catch((error) => {
        container.dataset.artalkBound = 'false';
        container.replaceChildren(document.createTextNode(error instanceof Error ? error.message : '评论加载失败'));
      });
    });
  };

  const destroyAllArtalk = () => {
    document.querySelectorAll<ArtalkContainer>('[data-artalk-comments]').forEach((container) => {
      container.__artalkThemeObserver?.disconnect();
      container.__artalk?.destroy();
      delete container.__artalkThemeObserver;
      delete container.__artalk;
      delete container.dataset.artalkBound;
    });
  };

  const globalState = window as Window & { __artalkCommentsBound?: boolean };

  initAllArtalk();
  if (!globalState.__artalkCommentsBound) {
    globalState.__artalkCommentsBound = true;
    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-scroll-to-comments]') : null;
      if (!button) return;
      document.getElementById('artalk-comments-title')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.addEventListener('astro:page-load', initAllArtalk);
    document.addEventListener('astro:before-swap', destroyAllArtalk);
  }
</script>
