---
import Card from '@/components/ui/Card.astro';
import { cn } from '@/lib/utils';
import { slugifySegment } from '@/lib/slug';
import type { PostCardData } from '@/types/post-card';

type Props = {
  data?: PostCardData;
  class?: string;
  disableLinks?: boolean;
  hideCoverPlaceholder?: boolean;
};

const { data, class: className, disableLinks = false, hideCoverPlaceholder = false } = Astro.props;
const chips = data?.tags.slice(0, 2) ?? [];
---

{
  data ? (
    <Card class={cn('group relative aspect-[5/7] rounded-xl border-0 bg-white p-0 shadow-sm dark:bg-neutral-900', className)}>
      <div class="absolute inset-0">
        {data.cover ? (
          <>
            <img
              src={data.cover}
              alt=""
              aria-hidden="true"
              class="absolute inset-0 h-full w-full scale-105 object-cover blur-lg brightness-[0.82] contrast-[0.92] dark:brightness-[0.72]"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-white/15 dark:bg-black/15" />
            <div class="absolute inset-x-0 bottom-0 h-[46%] bg-gradient-to-t from-black/55 via-black/15 to-transparent" />
          </>
        ) : (
          <div class="absolute inset-0 bg-gray-100 dark:bg-neutral-800" />
        )}
      </div>

      <div class="relative z-10 flex h-full flex-col p-3">
        <a href={data.href} class="flex min-h-0 flex-1 items-center justify-center">
          {data.cover ? (
            <img
              src={data.cover}
              alt={data.title}
              class="block max-h-full max-w-full rounded-xl object-contain"
              loading="lazy"
              decoding="async"
            />
          ) : hideCoverPlaceholder ? null : (
            <div class="flex h-full w-full items-center justify-center rounded-xl text-sm text-[rgb(var(--color-text-muted))]">无封面</div>
          )}
        </a>

        <div class="space-y-2.5 px-1 pb-1 pt-3">
          <div class="hidden min-w-0 flex-nowrap items-center gap-x-2 overflow-hidden whitespace-nowrap text-[0.72rem] tracking-[0.01em] text-white sm:flex">
            {disableLinks ? (
              <span class="max-w-[50%] shrink truncate font-medium text-white">{data.category}</span>
            ) : (
              <a
                href={`/category/${slugifySegment(data.category)}/`}
                class="max-w-[50%] shrink truncate no-underline font-medium text-white"
              >
                {data.category}
              </a>
            )}
            {chips.map((tag, index) =>
              disableLinks ? (
                <span class={cn('shrink-0 truncate text-white', index > 0 ? 'max-w-[40%]' : 'max-w-[45%]')}>
                  #{tag}
                </span>
              ) : (
                <a
                  href={`/tag/${slugifySegment(tag)}/`}
                  class={cn('shrink-0 truncate no-underline text-white', index > 0 ? 'max-w-[40%]' : 'max-w-[45%]')}
                >
                  #{tag}
                </a>
              )
            )}
          </div>
          <a href={data.href} class="block no-underline text-inherit">
            <h3 class="line-clamp-2 text-[0.9rem] font-semibold leading-[1.32] tracking-[-0.02em] text-white sm:text-[1.02rem]">
              {data.title}
            </h3>
          </a>
        </div>
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-20 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      >
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03))]" />
      </div>
    </Card>
  ) : null
}
