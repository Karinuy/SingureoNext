---
import { cn } from '@/lib/utils';
import { slugifySegment } from '@/lib/slug';
import type { PostCardData } from '@/types/post-card';

type Props = {
  data?: PostCardData;
  class?: string;
  disableLinks?: boolean;
  hideCoverPlaceholder?: boolean;
};

const { data, class: className, disableLinks = false, hideCoverPlaceholder = false } = Astro.props;
const tags = data?.tags.slice(0, 2) ?? [];
const metaClass =
  'inline-flex shrink-0 items-center rounded-lg border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface-muted))] px-2.5 py-1 text-xs font-medium text-[rgb(var(--color-text-muted))]';
---

{
  data ? (
    <article
      class={cn(
        'flex h-full flex-col overflow-hidden rounded-xl border border-[rgb(var(--color-border)_/_0.9)] bg-white dark:bg-black',
        className
      )}
    >
      <a
        href={data.href}
        class="block aspect-[3/4] overflow-hidden border-b border-[rgb(var(--color-border)_/_0.9)] bg-gray-100 no-underline dark:bg-neutral-900"
        aria-label={data.title}
      >
        <div class="flex h-full w-full items-center justify-center">
          {data.cover ? (
            <img
              src={data.cover}
              alt={data.title}
              class="block h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : hideCoverPlaceholder ? null : (
            <span class="text-sm text-[rgb(var(--color-text-muted))]">无封面</span>
          )}
        </div>
      </a>

      <div class="flex min-w-0 flex-1 flex-col gap-2 p-3">
        <a href={data.href} class="block no-underline" aria-label={data.title}>
          <h3 class="line-clamp-2 text-[0.95rem] font-semibold leading-[1.35] tracking-[-0.02em] text-[rgb(var(--color-text))] sm:text-[1.02rem]">
            {data.title}
          </h3>
        </a>

        <div class="mt-auto overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <div class="flex w-max min-w-full flex-nowrap gap-1.5">
            {disableLinks ? (
              <span class={metaClass}>{data.category}</span>
            ) : (
              <a href={`/category/${slugifySegment(data.category)}/`} class={metaClass}>
                {data.category}
              </a>
            )}
            {tags.map((tag) =>
              disableLinks ? (
                <span class={metaClass}>#{tag}</span>
              ) : (
                <a href={`/tag/${slugifySegment(tag)}/`} class={metaClass}>
                  #{tag}
                </a>
              )
            )}
          </div>
        </div>
      </div>
    </article>
  ) : null
}
