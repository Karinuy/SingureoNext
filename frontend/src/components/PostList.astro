---
import PostCard from '@/components/PostCard.astro';
import type { PostCardData } from '@/types/post-card';

type Props = {
  items: PostCardData[];
  class?: string;
  hideCoverPlaceholder?: boolean;
};

const {
  items,
  class: className,
  hideCoverPlaceholder = false,
} = Astro.props;
---

{
  items?.length ? (
    <div class={className ?? 'post-list-grid'}>
      {items.map((item) => (
        <div class="h-full">
          <PostCard data={item} hideCoverPlaceholder={hideCoverPlaceholder} />
        </div>
      ))}
    </div>
  ) : null
}
