---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'loading'> & {
  src: string;
  class?: string;
};

const {
  src,
  srcset,
  sizes,
  class: className,
  decoding = 'async',
  alt = '',
  ...attrs
} = Astro.props;
---

<img
  {...attrs}
  class={cn('lazy', className)}
  data-src={src}
  data-srcset={srcset}
  data-sizes={sizes}
  alt={alt}
  decoding={decoding}
/>
