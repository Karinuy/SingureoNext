---
import { CalendarDays, ChevronDown, FileText, Folder, Gamepad2, Heart, Home, Tags } from '@lucide/astro';

const navIconMap = {
  calendarDays: CalendarDays,
  fileText: FileText,
  folder: Folder,
  gamepad2: Gamepad2,
  heart: Heart,
  home: Home,
  tags: Tags,
};

type NavIconName = keyof typeof navIconMap;
type NavItem = { label: string; href: string; icon?: NavIconName; target?: string; rel?: string; children?: NavItem[] };

type Props = {
  items: NavItem[];
};

const { items } = Astro.props;
---

<nav class="hidden items-center gap-0.5 md:flex">
  {items.map((item) => {
    const hasChildren = Boolean(item.children?.length);
    const Icon = item.icon ? navIconMap[item.icon] : undefined;
    const triggerClass = [
      'relative overflow-hidden rounded-xl px-3.5 py-2 text-[0.93rem] font-medium tracking-[-0.005em]',
      'text-[rgb(var(--color-text)_/_0.68)]',
    ];

    return hasChildren ? (
      <div class="group/nav relative">
        <a
          href={item.href}
          target={item.target}
          rel={item.rel}
          aria-haspopup="menu"
          class:list={[...triggerClass, 'inline-flex items-center gap-1.5']}
        >
          {Icon && <Icon class="size-4 shrink-0" />}
          <span>{item.label}</span>
          <ChevronDown class="size-4 shrink-0 transition-transform duration-150 group-hover/nav:rotate-180 group-focus-within/nav:rotate-180" />
        </a>
        <div class="pointer-events-none absolute left-0 top-full z-20 pt-2 opacity-0 transition duration-150 group-hover/nav:pointer-events-auto group-hover/nav:opacity-100 group-focus-within/nav:pointer-events-auto group-focus-within/nav:opacity-100">
          <div class="relative min-w-[11rem] rounded-xl border border-[rgb(var(--color-border)_/_0.5)] bg-[rgb(var(--color-surface))] p-1.5 shadow-lg before:absolute before:-top-1.5 before:left-6 before:size-3 before:rotate-45 before:border-l before:border-t before:border-[rgb(var(--color-border)_/_0.5)] before:bg-[rgb(var(--color-surface))] before:content-[''] dark:border-[rgb(var(--color-border)_/_0.38)] dark:before:border-[rgb(var(--color-border)_/_0.38)]">
            {item.children?.map((child) => {
              const ChildIcon = child.icon ? navIconMap[child.icon] : undefined;
              return (
                <a
                  href={child.href}
                  target={child.target}
                  rel={child.rel}
                  class:list={[
                    'flex items-center gap-2 rounded-lg px-3 py-2 text-[0.9rem] font-medium tracking-[-0.005em]',
                    'text-[rgb(var(--color-text)_/_0.72)] hover:bg-[rgb(var(--color-surface-muted)_/_0.8)]',
                  ]}
                >
                  {ChildIcon && <ChildIcon class="size-4 shrink-0" />}
                  <span>{child.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    ) : (
      <a
        href={item.href}
        target={item.target}
        rel={item.rel}
        class:list={[...triggerClass, 'inline-flex items-center gap-1.5']}
      >
        {Icon && <Icon class="size-4 shrink-0" />}
        <span>{item.label}</span>
      </a>
    );
  })}
</nav>
