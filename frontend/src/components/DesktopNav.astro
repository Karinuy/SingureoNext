---
import { CalendarDays, FileText, Folder, Gamepad2, Heart, Home, Tags } from '@lucide/astro';

const navIconMap = {
  calendarDays: CalendarDays,
  fileText: FileText,
  folder: Folder,
  gamepad2: Gamepad2,
  heart: Heart,
  home: Home,
  tags: Tags,
};

type NavIconName = keyof typeof navIconMap;
type NavItem = { label: string; href: string; icon?: NavIconName; target?: string; rel?: string; children?: NavItem[] };

type Props = {
  items: NavItem[];
};

const { items } = Astro.props;
---

<nav class="flex items-center gap-0.5">
  {items.map((item) => {
    const hasChildren = Boolean(item.children?.length);
    const Icon = item.icon ? navIconMap[item.icon] : undefined;
    const triggerClass = [
      'desktop-nav-item',
      'relative inline-flex items-center gap-1.5',
    ];

    return hasChildren ? (
      <div class="group relative">
        <a
          href={item.href}
          target={item.target}
          rel={item.rel}
          aria-haspopup="menu"
          class:list={triggerClass}
        >
          {Icon && <Icon class="size-4 shrink-0" />}
          <span>{item.label}</span>
        </a>
        <div class="desktop-nav-submenu">
          <div class="desktop-nav-submenu__panel" role="menu">
            {item.children?.map((child) => {
              const ChildIcon = child.icon ? navIconMap[child.icon] : undefined;
              return (
                <a
                  href={child.href}
                  target={child.target}
                  rel={child.rel}
                  class="desktop-nav-submenu__item"
                  role="menuitem"
                >
                  {ChildIcon && <ChildIcon class="size-4 shrink-0" />}
                  <span>{child.label}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    ) : (
      <a
        href={item.href}
        target={item.target}
        rel={item.rel}
        class:list={triggerClass}
      >
        {Icon && <Icon class="size-4 shrink-0" />}
        <span>{item.label}</span>
      </a>
    );
  })}
</nav>
