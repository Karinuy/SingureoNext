---
import { Share2 } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';

type Props = {
  title: string;
  url: string;
};

const { title, url } = Astro.props;
---

<Button
  variant="outline"
  data-share-button
  data-share-title={title}
  data-share-url={url}
  ariaLabel="分享"
>
  <Share2 class="size-4" data-share-icon />
  <span data-share-label>分享</span>
</Button>

<script>
  const copyText = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const el = document.createElement('textarea');
        el.value = text;
        el.setAttribute('readonly', 'true');
        el.style.position = 'fixed';
        el.style.top = '-9999px';
        document.body.appendChild(el);
        el.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(el);
        return ok;
      } catch {
        return false;
      }
    }
  };

  const init = () => {
    document.querySelectorAll('[data-share-button]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', async () => {
        if (button.disabled) return;
        button.disabled = true;
        try {
          const shareTitle = button.dataset.shareTitle || '';
          const shareUrl = button.dataset.shareUrl || '';
          const copied = await copyText(`${shareTitle} | ${shareUrl}`);

          if (copied) {
            const label = button.querySelector('[data-share-label]');
            const icon = button.querySelector('[data-share-icon]');
            if (label) {
              label.textContent = '已分享';
              icon?.classList.add('text-amber-500');
              window.setTimeout(() => {
                label.textContent = '分享';
                icon?.classList.remove('text-amber-500');
              }, 1500);
            }
          }
        } finally {
          button.disabled = false;
        }
      });
    });
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
