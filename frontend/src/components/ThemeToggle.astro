---
import { Moon, Sun } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
---

<Button
  variant="ghost"
  size="icon"
  class="rounded-full md:size-11"
  ariaLabel="切换主题"
  title="切换明暗主题"
  data-theme-toggle
>
  <span class="relative z-10 h-5 w-5">
    <span data-theme-icon="sun" class="absolute inset-0 hidden items-center justify-center">
      <Sun class="size-[18px]" />
    </span>
    <span data-theme-icon="moon" class="absolute inset-0 flex items-center justify-center">
      <Moon class="size-[18px]" />
    </span>
  </span>
</Button>

<script>
  (() => {
    const key = '__themeToggleBound';
    if (window[key]) return;
    const root = document.documentElement;

    const getPreferredTheme = () => {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') return stored;
      return window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const applyTheme = (theme) => {
      root.classList.toggle('dark', theme === 'dark');
      root.style.colorScheme = theme;
    };

    const syncButtons = (theme) => {
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const isDark = theme === 'dark';
        button.setAttribute('aria-label', isDark ? '切换到浅色模式' : '切换到深色模式');
        button.querySelector('[data-theme-icon="sun"]')?.classList.toggle('hidden', !isDark);
        button.querySelector('[data-theme-icon="sun"]')?.classList.toggle('flex', isDark);
        button.querySelector('[data-theme-icon="moon"]')?.classList.toggle('hidden', isDark);
        button.querySelector('[data-theme-icon="moon"]')?.classList.toggle('flex', !isDark);
      });
    };

    const setTheme = (theme) => {
      localStorage.setItem('theme', theme);
      applyTheme(theme);
      syncButtons(theme);
    };

    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      const next = getPreferredTheme() === 'dark' ? 'light' : 'dark';
      setTheme(next);
    });

    const initialTheme = getPreferredTheme();
    applyTheme(initialTheme);
    syncButtons(initialTheme);
    document.addEventListener('astro:page-load', () => syncButtons(getPreferredTheme()));
    window[key] = true;
  })();
</script>
