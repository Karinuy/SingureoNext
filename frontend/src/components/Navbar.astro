---
import { site } from '../config/site';
import { resolveLink } from '../lib/redirect';
import RandomButton from './RandomButton.astro';
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import DesktopNav from './DesktopNav.astro';
import NavSearch from './NavSearch.astro';

type NavItem = {
  label: string;
  href: string;
  icon?: string;
  children?: NavItem[];
};

type ResolvedNavItem = {
  label: string;
  href: string;
  icon?: string;
  target?: string;
  rel?: string;
  children?: ResolvedNavItem[];
};

function resolveNavItem(item: NavItem): ResolvedNavItem {
  return {
    label: item.label,
    icon: item.icon,
    ...resolveLink(item.href),
    children: item.children?.map(resolveNavItem),
  };
}

const navItems = site.nav.map((item) => resolveNavItem(item as NavItem));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[70] bg-[rgb(var(--color-surface)_/_0.2)] backdrop-blur-xl md:bg-transparent md:backdrop-blur-none"
>
  <div class="mx-auto max-w-7xl md:hidden">
    <div class="relative flex min-h-16 items-center justify-between gap-2 px-3 py-3">
      <div class="relative z-10 flex items-center">
        <MobileNav nav={navItems} />
      </div>
      <a
        href="/"
        class="pointer-events-auto absolute left-1/2 top-1/2 z-0 flex -translate-x-1/2 -translate-y-1/2 items-center"
      >
        <img
          src="/SingureoLogo.png"
          alt={site.name}
          width="96"
          height="20"
          class="h-[1.125rem] w-auto"
          decoding="async"
        />
      </a>
      <div class="relative z-10 flex items-center gap-0.5">
        <RandomButton />
        <NavSearch mode="mobile" />
        <ThemeToggle />
      </div>
    </div>
  </div>

  <div class="mx-auto hidden max-w-7xl px-4 md:block">
    <div
      id="desktop-nav-shell"
      class="relative flex min-h-14 items-center justify-between gap-3 py-2.5 md:gap-4"
    >
      <div class="nav-capsule nav-capsule--logo">
        <a href="/" class="flex shrink-0 items-center px-1">
          <img
            src="/SingureoLogo.png"
            alt={site.name}
            width="104"
            height="22"
            class="h-[1.125rem] w-auto"
            decoding="async"
          />
        </a>
      </div>

      <div class="nav-capsule nav-capsule--menu min-w-0">
        <span class="nav-capsule__mica" aria-hidden="true"></span>
        <DesktopNav items={navItems} />
      </div>

      <div class="nav-capsule nav-capsule--actions">
        <NavSearch mode="desktop" />
        <RandomButton />
        <ThemeToggle />
      </div>
    </div>
  </div>
  <NavSearch mode="dialog" />
</header>

<script>
  (() => {
    const key = '__desktopNavScrollBound';
    if (window[key]) return;

    const THRESHOLD = 36;
    let raf = 0;

    const sync = () => {
      const shell = document.getElementById('desktop-nav-shell');
      if (!shell) return;
      shell.classList.toggle('is-scrolled', window.scrollY > THRESHOLD);
    };

    const onScroll = () => {
      if (raf) return;
      raf = window.requestAnimationFrame(() => {
        raf = 0;
        sync();
      });
    };

    sync();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', sync);
    window[key] = true;
  })();
</script>
