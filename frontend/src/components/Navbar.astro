---
import { site } from '../config/site';
import { resolveLink } from '../lib/redirect';
import RandomButton from './RandomButton.astro';
import MobileNav from './MobileNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import DesktopNav from './DesktopNav.astro';
import NavSearch from './NavSearch.astro';

type NavItem = {
  label: string;
  href: string;
  icon?: string;
  children?: NavItem[];
};

type ResolvedNavItem = {
  label: string;
  href: string;
  icon?: string;
  target?: string;
  rel?: string;
  children?: ResolvedNavItem[];
};

function resolveNavItem(item: NavItem): ResolvedNavItem {
  return {
    label: item.label,
    icon: item.icon,
    ...resolveLink(item.href),
    children: item.children?.map(resolveNavItem),
  };
}

const navItems = site.nav.map((item) => resolveNavItem(item as NavItem));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-[70] bg-[rgb(var(--color-surface)_/_0.2)] backdrop-blur-xl">
  <div class="mx-auto max-w-7xl md:hidden">
    <div class="relative flex min-h-16 items-center justify-between gap-2 px-3 py-3">
      <div class="flex min-w-0 items-center gap-2">
        <MobileNav logoText={site.logoText} nav={navItems} />
        <a href="/" class="min-w-0 px-1 py-1">
          <span class="brand-wordmark block whitespace-nowrap text-sm tracking-tight leading-none translate-y-[0.04em]">
            {site.logoText}
          </span>
        </a>
      </div>
      <div class="flex items-center gap-0.5">
        <RandomButton />
        <NavSearch mode="mobile" />
        <ThemeToggle />
      </div>
    </div>
  </div>

  <div class="mx-auto hidden max-w-[84rem] px-4 md:block">
    <div
      id="desktop-nav-shell"
      class="relative flex min-h-16 items-center justify-between gap-3 md:gap-4"
    >
      <div class="flex min-w-0 items-center gap-3">
        <a href="/" class="flex min-w-0 items-center px-2 py-1">
          <span class="brand-wordmark block whitespace-nowrap text-sm tracking-tight leading-none translate-y-[0.04em] md:text-[0.96rem]">
            {site.logoText}
          </span>
        </a>
        <DesktopNav items={navItems} />
      </div>

      <div class="flex items-center gap-1">
        <NavSearch mode="desktop" />
        <RandomButton />
        <ThemeToggle />
      </div>
    </div>
  </div>
  <NavSearch mode="dialog" />
</header>

