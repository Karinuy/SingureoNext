---
import { Star } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';

type Props = {
  slug: string;
};

const { slug } = Astro.props;
---

<Button variant="outline" data-favorite-button data-slug={slug} ariaLabel="收藏">
  <span class="relative h-4 w-4">
    <span data-favorite-icon="filled" class="absolute inset-0 hidden items-center justify-center text-amber-400">
      <Star class="size-4 fill-current" fill="currentColor" />
    </span>
    <span data-favorite-icon="outline" class="absolute inset-0 flex items-center justify-center">
      <Star class="size-4" />
    </span>
  </span>
  <span data-favorite-label>收藏</span>
</Button>

<script>
  import { getFavorite, removeFavorite, upsertFavorite } from '@/lib/favorites-db';

  const syncButton = (button, favorite) => {
    button.dataset.favorite = favorite ? 'true' : 'false';
    button.setAttribute('aria-label', favorite ? '已收藏' : '收藏');
    button.querySelector('[data-favorite-label]')?.replaceChildren(document.createTextNode(favorite ? '已收藏' : '收藏'));
    button.querySelector('[data-favorite-icon="filled"]')?.classList.toggle('hidden', !favorite);
    button.querySelector('[data-favorite-icon="filled"]')?.classList.toggle('flex', favorite);
    button.querySelector('[data-favorite-icon="outline"]')?.classList.toggle('hidden', favorite);
    button.querySelector('[data-favorite-icon="outline"]')?.classList.toggle('flex', !favorite);
  };

  const init = () => {
    document.querySelectorAll('[data-favorite-button]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      const slug = button.dataset.slug || '';
      syncButton(button, false);

      getFavorite(slug)
        .then((favorite) => syncButton(button, Boolean(favorite)))
        .catch(() => {});

      button.addEventListener('click', async () => {
        if (!slug || button.disabled) return;
        button.disabled = true;
        try {
          if (button.dataset.favorite === 'true') {
            await removeFavorite(slug);
            syncButton(button, false);
          } else {
            await upsertFavorite({ slug });
            syncButton(button, true);
          }
        } catch {
        } finally {
          button.disabled = false;
        }
      });
    });
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
