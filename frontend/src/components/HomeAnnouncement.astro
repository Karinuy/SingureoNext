---
import Alert from './ui/Alert.astro';

type Props = {
  config?: {
    enabled?: boolean;
    title?: string;
    content?: string;
  };
};

const { config } = Astro.props;
const enabled = config?.enabled ?? false;
const title = config?.title ?? '公告';
const content = config?.content ?? '';
---

{
  enabled && content ? <Alert title={title} description={content} variant="info" /> : null
}
