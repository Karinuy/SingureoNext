---
import { ChevronDown, Menu, X } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Drawer from '@/components/ui/Drawer.astro';
import { resolveNavIcon, type NavIconName } from '@/lib/nav-icons';
import { site } from '../config/site';

type NavItem = { label: string; href: string; icon?: NavIconName; target?: string; rel?: string; children?: NavItem[] };

type Props = {
  nav: NavItem[];
};

const { nav } = Astro.props;
const panelId = 'mobile-nav-panel';
---

<>
  <Button
    variant="ghost"
    size="icon"
    class="rounded-full md:hidden"
    ariaLabel="打开菜单"
    title="打开导航菜单"
    data-drawer-open={panelId}
  >
    <Menu class="size-[18px]" />
  </Button>

  <Drawer
    id={panelId}
    dialogClass="md:hidden"
    class="p-4"
    closeLabel="关闭菜单"
  >
    <div class="flex items-center justify-between gap-3 pb-4">
      <img
        src="/SingureoLogo.png"
        alt={site.name}
        width="84"
        height="18"
        class="h-4 w-auto"
        decoding="async"
      />
      <Button variant="ghost" size="icon" class="rounded-full" ariaLabel="关闭菜单" data-drawer-close>
        <X class="size-[18px]" />
      </Button>
    </div>
    <div class="flex min-h-0 flex-1 flex-col gap-1 overflow-auto px-1 pb-[max(env(safe-area-inset-bottom),1rem)] pt-1">
      {nav.map((item, index) => {
        const hasChildren = Boolean(item.children?.length);
        const submenuId = `mobile-nav-submenu-${index}`;
        const Icon = resolveNavIcon(item.icon);
        return hasChildren ? (
          <div class="rounded-xl">
            <div class="flex items-center gap-1">
              <a
                href={item.href}
                target={item.target}
                rel={item.rel}
                class="flex min-w-0 flex-1 items-center gap-2 rounded-lg px-3 py-2.5 text-[0.94rem] font-medium tracking-[-0.005em] text-[rgb(var(--color-text)_/_0.78)]"
                data-drawer-close
              >
                {Icon && <Icon class="size-4 shrink-0" />}
                <span>{item.label}</span>
              </a>
              <button
                type="button"
                class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg text-[rgb(var(--color-text)_/_0.72)]"
                aria-label={`展开${item.label}子菜单`}
                aria-controls={submenuId}
                aria-expanded="false"
                data-subnav-toggle={submenuId}
              >
                <ChevronDown class="size-4 shrink-0 transition-transform duration-200" />
              </button>
            </div>
            <div
              id={submenuId}
              class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-200 ease-out"
              data-subnav-panel
            >
              <div class="overflow-hidden">
                <div class="mt-1 flex flex-col gap-1 pl-3">
                  {item.children?.map((child) => {
                    const ChildIcon = resolveNavIcon(child.icon);
                    return (
                      <a
                        href={child.href}
                        target={child.target}
                        rel={child.rel}
                        class="flex items-center gap-2 rounded-md px-3 py-2 text-[0.88rem] font-medium text-[rgb(var(--color-text)_/_0.72)]"
                        data-drawer-close
                      >
                        {ChildIcon && <ChildIcon class="size-4 shrink-0" />}
                        <span>{child.label}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            target={item.target}
            rel={item.rel}
            class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-[0.94rem] font-medium tracking-[-0.005em] text-[rgb(var(--color-text)_/_0.78)]"
            data-drawer-close
          >
            {Icon && <Icon class="size-4 shrink-0" />}
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  </Drawer>
</>

<script is:inline>
  (() => {
    const key = '__mobileSubnavToggleBound';
    if (window[key]) return;

    const syncToggleState = (button, expanded) => {
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      const icon = button.querySelector('svg');
      icon?.classList.toggle('rotate-180', expanded);
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest('[data-subnav-toggle]');
      if (!(button instanceof HTMLButtonElement)) return;

      const panelId = button.dataset.subnavToggle;
      if (!panelId) return;

      const panel = document.getElementById(panelId);
      if (!panel) return;

      const willExpand = button.getAttribute('aria-expanded') !== 'true';
      panel.classList.toggle('grid-rows-[0fr]', !willExpand);
      panel.classList.toggle('grid-rows-[1fr]', willExpand);
      panel.classList.toggle('opacity-0', !willExpand);
      panel.classList.toggle('opacity-100', willExpand);
      syncToggleState(button, willExpand);
    });

    window[key] = true;
  })();
</script>
