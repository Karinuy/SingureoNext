---
import Card from '@/components/ui/Card.astro';
import { site } from '@/config/site';
import { resolveLink } from '@/lib/redirect';
import { cn } from '@/lib/utils';
import LazyImage from '@/components/LazyImage.astro';

type AdItem = {
  title: string;
  href: string;
  image: string;
};

type AdConfig = {
  enabled?: boolean;
  items?: AdItem[];
};

type Props = {
  config?: AdConfig;
  items?: AdItem[];
  class?: string;
};

const { config = site.ads, items, class: className } = Astro.props;
const adItems = items ?? config?.items ?? [];
const enabled = config?.enabled ?? true;
---

{
  enabled && adItems.length ? (
    <div class={cn('grid gap-4', className)}>
      {adItems.map((item) => {
        const link = resolveLink(item.href);
        return (
          <a key={item.title} href={link.href} target={link.target} rel={link.rel} class="group block no-underline text-inherit">
            <Card class="overflow-hidden p-0">
              <div class="relative aspect-[1920/300] bg-gray-100 dark:bg-neutral-800">
                <LazyImage src={item.image} width={1920} height={300} alt={item.title} class="h-full w-full object-cover" />
                <span class="absolute right-1.5 top-1.5 inline-flex h-6 items-center rounded-md border border-white/35 bg-black/45 px-2 text-[10px] font-semibold leading-none tracking-wide text-white shadow-sm backdrop-blur-md sm:right-3 sm:top-3">
                  广告
                </span>
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 bg-black/10 opacity-0 transition-opacity duration-200 ease-out group-hover:opacity-100 dark:bg-black/25"
                />
              </div>
              <span class="sr-only">{item.title}</span>
            </Card>
          </a>
        );
      })}
    </div>
  ) : null
}
