---
import { Star } from '@lucide/astro';
import LazyImage from '@/components/LazyImage.astro';
import type { HomeCarouselSlide } from '@/lib/home-carousel';

type Props = {
  items: HomeCarouselSlide[];
  tag?: string;
};

const { items, tag = '站点推荐' } = Astro.props;
const slides = items ?? [];
---

{
  slides.length ? (
    <div
      class="home-carousel relative w-full bg-[rgb(var(--color-bg))]"
      data-carousel
      style={`--banner-theme: ${slides[0].color}; --banner-theme-rgb: ${slides[0].rgb};`}
    >
      <div class="home-carousel__content flex h-[230px] flex-col overflow-hidden sm:h-[260px] md:h-[340px] md:flex-row">
        <div class="home-carousel__left relative min-h-0 min-w-0 flex-1 overflow-hidden">
          <div class="home-carousel__banner relative h-full w-full overflow-hidden" data-carousel-banner>
            <div class="home-carousel__track h-full w-full" data-carousel-track>
              {slides.map((item, index) => (
                <a
                  href={item.href}
                  class:list={['home-carousel__slide', { 'is-active': index === 0 }]}
                  data-carousel-slide
                  data-theme={item.color}
                  data-theme-rgb={item.rgb}
                  data-title={item.title}
                  style={`--slide-index: ${index}; --slide-theme-rgb: ${item.rgb};`}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <LazyImage
                    src={item.image}
                    width={1600}
                    height={900}
                    alt={item.title}
                    class="home-carousel__cover"
                  />
                  <div class="home-carousel__mask" aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>

          <div class="pointer-events-none absolute bottom-3 left-3 z-[2] w-[min(92%,28rem)] text-left sm:bottom-5 sm:left-5 md:bottom-7 md:left-7">
            <a
              href={slides[0].href}
              class="pointer-events-auto line-clamp-2 text-[15px] font-bold leading-snug text-white no-underline drop-shadow-sm transition-opacity hover:opacity-90 sm:text-lg md:text-2xl"
              data-carousel-title
            >
              {slides[0].title}
            </a>
            <div class="mt-1.5 hidden items-center gap-1 text-xs text-white/80 md:flex">
              <Star class="size-3.5 shrink-0 fill-current" aria-hidden="true" />
              <span>{tag}</span>
            </div>
            {slides.length > 1 ? (
              <div class="mt-2 flex items-center gap-1.5 md:hidden">
                {slides.map((_, index) => (
                  <button
                    type="button"
                    aria-label={`跳转到第 ${index + 1} 张`}
                    class="h-1.5 w-1.5 rounded-full bg-white/40 transition-all duration-300 data-[active=true]:w-5 data-[active=true]:bg-white"
                    data-carousel-dot={index}
                    data-active={index === 0 ? 'true' : 'false'}
                  />
                ))}
              </div>
            ) : null}
          </div>
        </div>

        {slides.length > 1 ? (
          <aside class="home-carousel__right hidden h-full w-[30%] shrink-0 flex-col md:flex" aria-label="推荐列表">
            {slides.map((item, index) => (
              <button
                type="button"
                class:list={[
                  'home-carousel__item flex min-h-0 flex-1 items-center gap-3 px-4 text-left transition-colors duration-200',
                  { 'is-active': index === 0 },
                ]}
                data-carousel-item={index}
                data-active={index === 0 ? 'true' : 'false'}
              >
                <span class="relative size-9 shrink-0 overflow-hidden rounded-lg bg-white/15 ring-1 ring-white/20">
                  <LazyImage
                    src={item.image}
                    width={72}
                    height={72}
                    alt=""
                    class="block size-full object-cover"
                    data-no-dark-dim
                  />
                </span>
                <span class="min-w-0 flex-1 truncate text-[15px] font-medium leading-snug text-white/85">
                  {item.title}
                </span>
              </button>
            ))}
          </aside>
        ) : null}
      </div>
    </div>
  ) : null
}

<style>
  .home-carousel {
    overflow: hidden;
    overflow-anchor: none;
    border: 1px solid rgb(var(--color-border) / 0.9);
    border-radius: 0.75rem;
  }

  .home-carousel__track {
    position: relative;
  }

  .home-carousel__slide {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    background: rgb(var(--color-bg));
    opacity: 0;
    visibility: hidden;
    z-index: 0;
    text-decoration: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .home-carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .home-carousel__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-carousel__cover.lazy {
    --lazy-image-scale: 1.02;
    filter: brightness(var(--image-brightness)) blur(var(--lazy-image-blur, 0px));
    transform: scale(var(--lazy-image-scale));
  }

  .home-carousel__cover.lazy.loaded,
  .home-carousel__cover.lazy.error {
    --lazy-image-blur: 0;
  }

  .dark .home-carousel__cover.lazy {
    --image-brightness: 0.88;
  }

  .home-carousel__left {
    z-index: 1;
  }

  @media (min-width: 968px) {
    .home-carousel__left::after {
      content: '';
      position: absolute;
      inset: 0 0 0 auto;
      width: 36px;
      z-index: 4;
      pointer-events: none;
      background: linear-gradient(to right, transparent, rgb(var(--banner-theme-rgb) / 0.22));
    }
  }

  .home-carousel__mask {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    height: 42%;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(var(--slide-theme-rgb) / 0.88),
      rgb(var(--slide-theme-rgb) / 0.35) 45%,
      transparent
    );
  }

  .home-carousel__right {
    position: relative;
    z-index: 2;
    margin-left: -1px;
    background:
      linear-gradient(to right, rgb(var(--banner-theme-rgb) / 0.42), transparent 22%),
      linear-gradient(160deg, rgb(28 28 28), rgb(52 52 52));
  }

  .home-carousel__right::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 28px;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to right, rgb(var(--banner-theme-rgb) / 0.28), transparent);
  }

  .dark .home-carousel__right {
    background:
      linear-gradient(to right, rgb(var(--banner-theme-rgb) / 0.38), transparent 22%),
      linear-gradient(160deg, rgb(16 16 16), rgb(36 36 36));
  }

  .home-carousel__item {
    background: rgb(var(--banner-theme-rgb) / 0.28);
  }

  .home-carousel__item:hover {
    background: rgb(var(--banner-theme-rgb) / 0.55);
  }

  .home-carousel__item.is-active {
    background: rgb(var(--banner-theme-rgb) / 0.95);
  }

  .home-carousel__item.is-active span:last-child {
    color: #fff;
  }

  @media (max-width: 967px) {
    .home-carousel__banner {
      touch-action: pan-y;
      user-select: none;
      -webkit-user-select: none;
    }

    .home-carousel__track {
      transition: transform 0.35s ease;
    }

    .home-carousel__track.is-dragging {
      transition: none;
    }

    .home-carousel__slide {
      inset: auto;
      top: 0;
      bottom: 0;
      left: calc(var(--slide-index) * 100%);
      width: 100%;
      height: 100%;
      opacity: 1;
      visibility: visible;
      transition: none;
      -webkit-user-drag: none;
    }

    .home-carousel__mask {
      height: 52%;
    }
  }
</style>

<script>
  (() => {
    const g = (window.__homeCarousel ??= { bound: false, disposers: new Set() });

    const mount = (root) => {
      if (!(root instanceof HTMLElement) || root.dataset.ready) return;
      const slides = [...root.querySelectorAll('[data-carousel-slide]')];
      const itemEls = [...root.querySelectorAll('[data-carousel-item]')];
      const dotEls = [...root.querySelectorAll('[data-carousel-dot]')];
      const banner = root.querySelector('[data-carousel-banner]');
      const track = root.querySelector('[data-carousel-track]');
      const title = root.querySelector('[data-carousel-title]');
      const mq = matchMedia('(max-width: 967px)');
      const n = slides.length;
      if (!n || !(banner instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

      root.dataset.ready = '1';
      const ac = new AbortController();
      const opt = { signal: ac.signal };
      let i = 0;
      let timer = 0;
      let paused = false;
      let hold = false;
      let pid = 0;
      let x0 = 0;
      let y0 = 0;
      let dx = 0;
      let dragging = false;
      let axis = '';
      let blockClick = false;

      const mobile = () => mq.matches;

      const paint = (offset = 0) => {
        track.classList.toggle('is-dragging', dragging);
        track.style.transform = mobile()
          ? `translate3d(${-i * banner.clientWidth + offset}px,0,0)`
          : '';
      };

      const go = (next) => {
        if (next < 0 || next >= n) return;
        i = next;
        slides.forEach((el, k) => {
          const on = k === i;
          el.classList.toggle('is-active', on);
          el.setAttribute('aria-hidden', on ? 'false' : 'true');
          el.tabIndex = on ? 0 : -1;
        });
        itemEls.forEach((el, k) => {
          el.classList.toggle('is-active', k === i);
          el.setAttribute('data-active', k === i ? 'true' : 'false');
        });
        dotEls.forEach((el, k) => el.setAttribute('data-active', k === i ? 'true' : 'false'));
        const s = slides[i];
        root.style.setProperty('--banner-theme', s.getAttribute('data-theme') || '#085EFF');
        root.style.setProperty('--banner-theme-rgb', s.getAttribute('data-theme-rgb') || '8 94 255');
        if (title instanceof HTMLAnchorElement) {
          title.href = s.getAttribute('href') || '#';
          title.textContent = s.getAttribute('data-title') || '';
        }
        paint();
      };

      const stop = () => {
        clearInterval(timer);
        timer = 0;
      };

      const play = () => {
        stop();
        if (!paused && n > 1) timer = setInterval(() => go((i + 1) % n), 4500);
      };

      const setPaused = (v) => {
        paused = v;
        v ? stop() : play();
      };

      const endDrag = () => {
        if (!hold) return;
        const moved = dragging;
        const off = dx;
        hold = false;
        dragging = false;
        axis = '';
        if (moved) {
          blockClick = true;
          const t = Math.max(banner.clientWidth * 0.18, 40);
          if (off <= -t) go(Math.min(n - 1, i + 1));
          else if (off >= t) go(Math.max(0, i - 1));
          else paint();
          setTimeout(() => {
            blockClick = false;
          }, 50);
        } else paint();
        setPaused(false);
      };

      root.addEventListener('mouseenter', () => setPaused(true), opt);
      root.addEventListener('mouseleave', () => setPaused(false), opt);
      root.addEventListener('focusin', () => setPaused(true), opt);
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget)) setPaused(false);
      }, opt);

      root.addEventListener(
        'pointerover',
        (e) => {
          if (mobile()) return;
          const el = e.target.closest('[data-carousel-item]');
          if (!el || !root.contains(el)) return;
          go(Number(el.getAttribute('data-carousel-item') || 0));
          play();
        },
        opt
      );

      root.addEventListener(
        'click',
        (e) => {
          if (blockClick) {
            e.preventDefault();
            e.stopPropagation();
            blockClick = false;
            return;
          }
          const item = e.target.closest('[data-carousel-item]');
          if (item && root.contains(item)) {
            const s = slides[Number(item.getAttribute('data-carousel-item') || 0)];
            if (s instanceof HTMLAnchorElement) location.assign(s.href);
            return;
          }
          const dot = e.target.closest('[data-carousel-dot]');
          if (dot && root.contains(dot)) {
            go(Number(dot.getAttribute('data-carousel-dot') || 0));
            play();
          }
        },
        opt
      );

      banner.addEventListener(
        'pointerdown',
        (e) => {
          if (!mobile() || n < 2 || e.button !== 0) return;
          hold = true;
          pid = e.pointerId;
          x0 = e.clientX;
          y0 = e.clientY;
          dx = 0;
          dragging = false;
          axis = '';
          setPaused(true);
        },
        opt
      );

      banner.addEventListener(
        'pointermove',
        (e) => {
          if (!hold || e.pointerId !== pid) return;
          const x = e.clientX - x0;
          const y = e.clientY - y0;
          if (!axis) {
            if (Math.abs(x) < 6 && Math.abs(y) < 6) return;
            axis = Math.abs(x) >= Math.abs(y) ? 'x' : 'y';
            if (axis === 'x') {
              dragging = true;
              try {
                banner.setPointerCapture(pid);
              } catch {}
            } else {
              hold = false;
              setPaused(false);
              return;
            }
          }
          if (axis !== 'x') return;
          e.preventDefault();
          dx = x;
          if ((i === 0 && dx > 0) || (i === n - 1 && dx < 0)) dx *= 0.35;
          paint(dx);
        },
        { ...opt, passive: false }
      );

      banner.addEventListener('pointerup', endDrag, opt);
      banner.addEventListener('pointercancel', endDrag, opt);

      const onResize = () => {
        hold = false;
        dragging = false;
        axis = '';
        paint();
        play();
      };
      addEventListener('resize', onResize, opt);
      mq.addEventListener('change', onResize);
      document.addEventListener(
        'visibilitychange',
        () => (document.visibilityState === 'visible' ? play() : stop()),
        opt
      );

      const dispose = () => {
        ac.abort();
        mq.removeEventListener('change', onResize);
        stop();
        track.style.transform = '';
        delete root.dataset.ready;
        g.disposers.delete(dispose);
      };
      g.disposers.add(dispose);

      go(0);
      play();
    };

    const init = () => document.querySelectorAll('[data-carousel]').forEach(mount);
    init();
    if (!g.bound) {
      document.addEventListener('astro:page-load', init);
      document.addEventListener('astro:before-swap', () => {
        [...g.disposers].forEach((d) => d());
      });
      g.bound = true;
    }
  })();
</script>
