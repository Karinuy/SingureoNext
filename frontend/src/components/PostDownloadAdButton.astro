---
import { Megaphone } from '@lucide/astro';
import LazyImage from '@/components/LazyImage.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
import { resolveAdItems, type AdConfig } from '@/lib/post-list-ads';
import { resolveLink } from '@/lib/redirect';
import { cn } from '@/lib/utils';

type Props = {
  config?: AdConfig;
  class?: string;
};

const {
  config = site.ads,
  class: className,
} = Astro.props;

const ads = resolveAdItems(config)
  .filter((item) => item.title.trim() && item.href.trim())
  .map((item) => ({
    title: item.title,
    image: item.image,
    link: resolveLink(item.href),
  }));
---

{
  ads.map((ad) => (
    <Button
      href={ad.link.href}
      target={ad.link.target}
      rel={ad.link.rel}
      variant="solid"
      class={cn('group/post-download-ad relative w-full whitespace-normal break-all pr-8 sm:w-auto', className)}
      ariaLabel={`广告：${ad.title}`}
    >
      <span class="absolute -right-1 -top-1 inline-flex h-4 items-center rounded border border-current bg-[rgb(var(--color-primary)_/_0.84)] px-1 text-[9px] font-semibold leading-none text-[rgb(var(--color-primary-foreground))]">
        广告
      </span>
      {ad.image.trim() ? (
        <span class="pointer-events-none absolute bottom-[calc(100%+0.5rem)] left-1/2 z-30 hidden w-96 origin-bottom -translate-x-1/2 translate-y-4 scale-75 overflow-hidden rounded-xl bg-gray-100 opacity-0 shadow-xl transition-[opacity,transform] duration-300 ease-out dark:bg-neutral-800 sm:block sm:group-hover/post-download-ad:translate-y-0 sm:group-hover/post-download-ad:scale-100 sm:group-hover/post-download-ad:opacity-100 sm:group-focus-visible/post-download-ad:translate-y-0 sm:group-focus-visible/post-download-ad:scale-100 sm:group-focus-visible/post-download-ad:opacity-100 md:w-[28rem]">
          <span class="block aspect-[1920/300] overflow-hidden">
            <LazyImage
              src={ad.image}
              width={1920}
              height={300}
              alt={ad.title}
              class="h-full w-full object-cover"
            />
          </span>
        </span>
      ) : null}
      <Megaphone class="size-4" />
      {ad.title}
    </Button>
  ))
}
