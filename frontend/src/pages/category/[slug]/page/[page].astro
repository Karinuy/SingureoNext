---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Pagination from '../../../../components/ui/Pagination.astro';
import PostList from '../../../../components/PostList.astro';
import { getEntryCategories, getPosts } from '../../../../lib/content';
import { slugifySegment } from '../../../../lib/slug';
import { postToCardData } from '../../../../lib/post-card';
import { getPageCount, paginate } from '../../../../lib/paginate';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const PAGE_SIZE = 24;
  const posts = await getPosts();
  const categories = Array.from(new Set(posts.flatMap((p) => getEntryCategories(p))));

  const paths: Array<{ params: { slug: string; page: string }; props: { categoryName: string } }> = [];

  for (const category of categories) {
    const list = posts.filter((p) => getEntryCategories(p).includes(category));
    const pageCount = getPageCount(list.length, PAGE_SIZE);
    for (let page = 2; page <= pageCount; page++) {
      paths.push({
        params: { slug: slugifySegment(category), page: String(page) },
        props: { categoryName: category },
      });
    }
  }

  return paths;
}

const page = Number(Astro.params.page ?? '1');
const { categoryName } = Astro.props as { categoryName: string };
const posts = await getPosts();
const list = posts.filter((p) => getEntryCategories(p).includes(categoryName));
const pageData = paginate(list, page, PAGE_SIZE);
const base = `/category/${slugifySegment(categoryName)}`;
const postCards = pageData.items.map((entry) => postToCardData(entry));
const categoryPageHref = (targetPage: number) =>
  targetPage === 1 ? `${base}/` : `${base}/page/${targetPage}/`;
---

<BaseLayout
  title={`分类：${categoryName}（第 ${pageData.page} 页）`}
  description={`分类 ${categoryName} 下的文章`}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '分类', href: '/categories' },
    { label: categoryName, href: `${base}/` },
    { label: `第 ${pageData.page} 页` },
  ]}
>
  <div class="flex flex-wrap items-end gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">分类：{categoryName}</h1>
      <p class="mt-2 text-sm text-[rgb(var(--color-text-muted))]">共 {pageData.total} 篇</p>
    </div>
  </div>

  <div class="mt-6">
    <PostList items={postCards} />
  </div>

  {pageData.pageCount > 1 ? (
    <div class="mt-8 flex justify-center">
      <Pagination current={pageData.page} pageCount={pageData.pageCount} hrefBuilder={categoryPageHref} />
    </div>
  ) : null}
</BaseLayout>

