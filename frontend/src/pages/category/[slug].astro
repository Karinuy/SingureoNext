---
import { getEntryCategories, getPosts } from '../../lib/content';
import { slugifySegment } from '../../lib/slug';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/ui/Pagination.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../config/site';
import { postToCardData } from '../../lib/post-card';
import { paginate, POSTS_PAGE_SIZE } from '../../lib/paginate';

export async function getStaticPaths() {
  const games = await getPosts();
  const categories = Array.from(new Set(games.flatMap((g) => getEntryCategories(g))));
  return categories.map((category) => ({
    params: { slug: slugifySegment(category) },
    props: { categoryName: category },
  }));
}

const { categoryName } = Astro.props as { categoryName: string };
const games = await getPosts();
const list = games.filter((g) => getEntryCategories(g).includes(categoryName));
const pageData = paginate(list, 1, POSTS_PAGE_SIZE);
const postCards = pageData.items.map((entry) => postToCardData(entry));
const categoryHref = (page: number) =>
  page === 1
    ? `/category/${slugifySegment(categoryName)}/`
    : `/category/${slugifySegment(categoryName)}/page/${page}/`;
---

<BaseLayout
  title={`分类：${categoryName}`}
  description={`分类 ${categoryName} 下的文章`}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '分类', href: '/categories' },
    { label: categoryName },
  ]}
>
  <div class="flex flex-wrap items-end gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">分类：{categoryName}</h1>
      <p class="mt-2 text-sm text-[rgb(var(--color-text-muted))]">共 {list.length} 篇</p>
    </div>
  </div>

  <div class="mt-6">
    <PostList items={postCards} />
  </div>

  {pageData.pageCount > 1 ? (
    <div class="mt-8 flex justify-center">
      <Pagination current={pageData.page} pageCount={pageData.pageCount} hrefBuilder={categoryHref} />
    </div>
  ) : null}
</BaseLayout>
