---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { getEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Card from '../../components/ui/Card.astro';
import Tag from '../../components/ui/Tag.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntryCategories, getEntrySlug, getEntryTags } from '../../lib/content';
import { slugifySegment } from '../../lib/slug';
import PostList from '../../components/PostList.astro';
import { postToCardData } from '../../lib/post-card';
import ShareButton from '../../components/ShareButton.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import { extractSummaryFromMarkdown } from '../../lib/markdown-summary';
import PostDownloadButton from '../../components/PostDownloadButton.astro';
import PostComments from '../../components/PostComments.astro';

export async function getStaticPaths() {
  const entries = await getCollection('post', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props as { id: CollectionEntry<'post'>['id'] };
const entry = (await getEntry('post', id)) as CollectionEntry<'post'> | undefined;
if (!entry) {
  throw new Error(`Post not found for id: ${id}`);
}
const slug = getEntrySlug(entry);
const { title, cover, downloadUrl, downloads, description } = entry.data;
const categories = getEntryCategories(entry);
const tags = getEntryTags(entry);
const { Content } = await render(entry);
const keywords = Array.from(new Set([title, ...categories, ...tags]));
const primaryCategory = categories[0] ?? '未分类';
const shareUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const pageDescription =
  (description ?? '').trim() ||
  extractSummaryFromMarkdown(entry.body ?? '', { maxLength: 160 });

const all = await getCollection('post', ({ data }) => !data.draft);
const related = all
  .filter((e) => e.id !== entry.id)
  .map((e) => ({
    entry: e,
    score: getEntryTags(e).filter((t) => tags.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((x) => x.entry);
const relatedCards = related.map((entry) => postToCardData(entry));
---

<BaseLayout
  title={title}
  description={pageDescription}
  keywords={keywords}
  image={cover}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '分类', href: '/categories' },
    { label: primaryCategory, href: `/category/${slugifySegment(primaryCategory)}/` },
    { label: title },
  ]}
>
  <section class="space-y-5">
    <Card class="overflow-hidden p-0">
      <div class="grid grid-cols-[minmax(108px,34vw)_minmax(0,1fr)] sm:grid-cols-[minmax(170px,210px)_minmax(0,1fr)] lg:grid-cols-[minmax(220px,260px)_minmax(0,1fr)]">
        <div class="relative h-full min-h-[180px] sm:min-h-[280px] lg:min-h-[360px]">
          {cover ? (
            <a
              href={cover}
              target="_blank"
              rel="noreferrer"
              aria-label={`在新标签页打开《${title}》封面`}
              class="absolute inset-0 block"
            >
              <Image
                src={cover}
                width={720}
                height={1080}
                alt={title}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
            </a>
          ) : (
            <div class="flex h-full min-h-[180px] items-center justify-center bg-white px-3 text-xs text-[rgb(var(--color-text-muted))] dark:bg-black sm:min-h-[280px] sm:px-4 sm:text-sm lg:min-h-[360px]">
              暂无封面
            </div>
          )}
        </div>

        <div class="flex min-w-0 flex-col gap-3 bg-white p-3 dark:bg-black sm:gap-5 sm:p-5 lg:p-6">
          <div>
            <h1 class="text-lg font-semibold leading-tight tracking-tight sm:text-3xl lg:text-4xl">{title}</h1>
          </div>

          <div class="space-y-2.5 sm:space-y-3">
            <div class="space-y-1.5 sm:space-y-2">
              <div class="text-[0.7rem] font-medium tracking-[0.08em] text-[rgb(var(--color-text-muted))] sm:text-xs">分类</div>
              <div class="overflow-x-auto sm:overflow-visible [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div class="flex w-max min-w-full flex-nowrap gap-1.5 sm:w-auto sm:min-w-0 sm:flex-wrap sm:gap-2">
                  {categories.length ? (
                    categories.map((c) => (
                      <Tag href={`/category/${slugifySegment(c)}/`} class="rounded-lg px-2 py-1 text-[0.72rem] sm:rounded-xl sm:px-3 sm:py-1.5 sm:text-sm">
                        {c}
                      </Tag>
                    ))
                  ) : (
                    <span class="text-xs text-[rgb(var(--color-text-muted))] sm:text-sm">暂无分类</span>
                  )}
                </div>
              </div>
            </div>

            <div class="space-y-1.5 sm:space-y-2">
              <div class="text-[0.7rem] font-medium tracking-[0.08em] text-[rgb(var(--color-text-muted))] sm:text-xs">标签</div>
              <div class="overflow-x-auto sm:overflow-visible [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div class="flex w-max min-w-full flex-nowrap gap-1.5 sm:w-auto sm:min-w-0 sm:flex-wrap sm:gap-2">
                  {tags.length ? (
                    tags.map((t) => (
                      <Tag href={`/tag/${slugifySegment(t)}/`} class="rounded-lg px-2 py-1 text-[0.72rem] sm:rounded-xl sm:px-3 sm:py-1.5 sm:text-sm">
                        #{t}
                      </Tag>
                    ))
                  ) : (
                    <span class="text-xs text-[rgb(var(--color-text-muted))] sm:text-sm">暂无标签</span>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Card>

    <div class="flex flex-wrap items-center gap-2">
      {downloads?.length ? (
        downloads.map((d) => (
          <PostDownloadButton label={d.label} href={d.url} />
        ))
      ) : downloadUrl ? (
        <PostDownloadButton label="下载" href={downloadUrl} />
      ) : null}
      <FavoriteButton slug={slug} />
      <ShareButton title={title} url={shareUrl} />
    </div>
  </section>

  <div class="mt-8">
    <Card class="p-0">
      <div class="p-4 sm:p-6">
        <article class="prose prose-zinc max-w-none dark:prose-invert">
          <Content />
        </article>
      </div>
    </Card>

    <PostComments pageKey={Astro.url.pathname} pageTitle={title} />

    {related.length ? (
      <section class="mt-10">
        <h2 class="text-base font-semibold tracking-tight">相关推荐</h2>
        <div class="mt-4">
          <PostList items={relatedCards} />
        </div>
      </section>
    ) : null}
  </div>
</BaseLayout>

