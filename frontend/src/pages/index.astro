---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import Pagination from '../components/ui/Pagination.astro';
import { getHomePosts } from '../lib/content';
import { postToCardData } from '../lib/post-card';
import { paginate, POSTS_PAGE_SIZE } from '../lib/paginate';
import PostList from '../components/PostList.astro';
import ImageAds from '../components/ImageAds.astro';
import LatestComments from '../components/LatestComments.astro';
import LatestDocs from '../components/LatestDocs.astro';

const games = await getHomePosts();
const pageData = paginate(games, 1, POSTS_PAGE_SIZE);
const postCards = pageData.items.map((entry) => postToCardData(entry, { includePinned: true }));
const homePageHref = (page: number) => (page === 1 ? '/' : `/page/${page}/`);
---

<BaseLayout title="首页" description={site.tagline}>
	<section>
		<ImageAds class="mb-6" />
		<LatestComments />
		<LatestDocs />

		<div class="flex items-end gap-4">
			<h2 class="text-lg font-semibold tracking-tight">最新文章</h2>
		</div>
		<div class="mt-4">
			<PostList items={postCards} />
		</div>

		{pageData.pageCount > 1 ? (
			<div class="mt-8 flex justify-center">
				<Pagination current={1} pageCount={pageData.pageCount} hrefBuilder={homePageHref} />
			</div>
		) : null}
	</section>
</BaseLayout>
