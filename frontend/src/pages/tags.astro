---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Pagination from '../components/ui/Pagination.astro';
import Tag from '../components/ui/Tag.astro';
import { getEntryTags, getPosts } from '../lib/content';
import { slugifySegment } from '../lib/slug';
import { paginate } from '../lib/paginate';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of getEntryTags(p)) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries()).sort((a, b) => a[0].localeCompare(b[0]));

const PAGE_SIZE = 21;
const pageData = paginate(tags, 1, PAGE_SIZE);
const tagsHref = (page: number) => (page === 1 ? '/tags' : `/tags/page/${page}/`);
---

<BaseLayout
  title="标签"
  description="文章标签"
  breadcrumbs={[{ label: '首页', href: '/' }, { label: '标签' }]}
>
  <div class="flex items-end gap-4">
    <h1 class="text-2xl font-semibold tracking-tight">标签</h1>
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {pageData.items.map(([t, n]) => (
      <Card class="p-0">
        <a class="flex min-h-[4.75rem] flex-col justify-center gap-1.5 px-4 py-3.5" href={`/tag/${slugifySegment(t)}/`}>
          <h3 class="truncate text-[15px] font-medium leading-snug tracking-tight sm:text-base">
            #{t}
          </h3>
          <Tag class="w-fit text-[11px] font-medium sm:text-xs">共 {n} 篇</Tag>
        </a>
      </Card>
    ))}
  </div>

  {pageData.pageCount > 1 ? (
    <div class="mt-8 flex justify-center">
      <Pagination current={pageData.page} pageCount={pageData.pageCount} hrefBuilder={tagsHref} />
    </div>
  ) : null}
</BaseLayout>

