---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import Pagination from '../../components/ui/Pagination.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';
import { postToCardData } from '../../lib/post-card';
import { getPageCount, paginate } from '../../lib/paginate';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const PAGE_SIZE = 24;
  const posts = await getPosts();
  const pageCount = getPageCount(posts.length, PAGE_SIZE);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, i) => {
    const page = i + 2;
    return { params: { page: String(page) } };
  });
}

const page = Number(Astro.params.page ?? '1');
const posts = await getPosts();
const pageData = paginate(posts, page, PAGE_SIZE);
const postCards = pageData.items.map((entry) => postToCardData(entry));
const pageHref = (targetPage: number) => (targetPage === 1 ? '/' : `/page/${targetPage}/`);
---

<BaseLayout
  title={`第 ${pageData.page} 页`}
  description={site.tagline}
  breadcrumbs={[{ label: '首页', href: '/' }, { label: `第 ${pageData.page} 页` }]}
>
  <div class="flex items-end gap-4">
    <h1 class="text-2xl font-semibold tracking-tight">最新文章</h1>
  </div>

  <div class="mt-6">
    <PostList items={postCards} />
  </div>

  {pageData.pageCount > 1 ? (
    <div class="mt-8 flex justify-center">
      <Pagination current={pageData.page} pageCount={pageData.pageCount} hrefBuilder={pageHref} />
    </div>
  ) : null}
</BaseLayout>

